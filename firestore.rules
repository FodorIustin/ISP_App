rules_version = '2';
// Firestore security rules. Deployed with scripts/deploy-translation.sh (or
// `firebase deploy --only firestore:rules`); edit here, not in the console.
// The server (Cloud Functions, the translation job) is not bound by these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    match /config/{document} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid;
    }

    match /lessons/{lessonId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /userProgress/{doc} {
      allow read, write: if request.auth != null;
    }

    match /userAnswers/{doc} {
      allow read, write: if request.auth != null;
    }

    match /chats/{chatId} {
      allow read, write: if request.auth != null;
    }

    match /chats/{chatId}/messages/{messageId} {
      allow read, write: if request.auth != null;
    }

    // Documents that can be translated. Only published ones are visible (a list query
    // must filter status == "published"). Written only by the server for now.
    match /documents/{documentId} {
      allow read: if request.auth != null
        && resource.data.status == 'published';
      allow write: if false;
    }

    // Who may upload documents (scripts/add-uploader.sh). A user can only see whether
    // they themselves are on the list (to show the Upload button).
    match /uploaders/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // One record per (document, language), written only by the server
    // (functions/translation, the translation job). Signed-in users follow its status.
    match /translations/{recordId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
