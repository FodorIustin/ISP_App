rules_version = '2';
// Storage security rules. Deployed with scripts/deploy-translation.sh (or
// `firebase deploy --only storage`); edit here, not in the console.
// Every folder the app uses is listed; anything else is closed to the app (the server is
// not bound by these rules). memory/ and config/ belong to the translation server only.
service firebase.storage {
  match /b/{bucket}/o {

    // profile photos (lib/services/auth_service.dart): everyone signed in sees them,
    // only the owner writes
    match /users/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // photos sent in chats (lib/services/chat_service.dart)
    match /chat_images/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // original documents and their translations: read-only for signed-in users,
    // written only by the server
    match /documents/{documentId}/{allPaths=**} {
      allow read: if request.auth != null;
    }
    match /translations/{documentId}/{allPaths=**} {
      allow read: if request.auth != null;
    }
  }
}
